# Required
OPENAI_API_KEY=sk-your-openai-api-key

# Qdrant: local or API (Cloud)
# Local Docker: use URL only
QDRANT_URL=http://localhost:6333
# Qdrant Cloud / remote API: set URL + API key
# QDRANT_URL=https://your-cluster.aws.cloud.qdrant.io
# QDRANT_API_KEY=your-qdrant-api-key

# Qdrant collection (created automatically if missing; default name below)
COLLECTION_NAME=credit_card_knowledge

# Embeddings: OpenAI only for this POC (model must be 1536-dim for Qdrant vector size)
EMBEDDING_PROVIDER=openai
# EMBED_MODEL=text-embedding-3-small

# Chat: model, temperature (lower = more deterministic for FAQ), max response tokens
CHAT_MODEL=gpt-4o
CHAT_TEMPERATURE=0.3
CHAT_MAX_TOKENS=600

# Query rewrite: before RAG, a small model turns conversational queries into clear search phrases (e.g. "suggest me cards" → "credit card options benefits")
# ENABLE_QUERY_REWRITE=true
# QUERY_REWRITE_MODEL=gpt-4o-mini

# Scraping: debug writes debug_<domain>.html in backend dir and logs more; headless=false opens visible browser
# SCRAPE_DEBUG=true
# SCRAPE_HEADLESS=false

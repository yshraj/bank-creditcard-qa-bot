# Required
OPENAI_API_KEY=sk-your-openai-api-key

# Qdrant: local or API (Cloud)
# Local Docker: use URL only
QDRANT_URL=http://localhost:6333
# Qdrant Cloud / remote API: set URL + API key
# QDRANT_URL=https://your-cluster.aws.cloud.qdrant.io
# QDRANT_API_KEY=your-qdrant-api-key

# Qdrant collection (created automatically if missing; default name below)
COLLECTION_NAME=credit_card_knowledge

# Embeddings: OpenAI only for this POC (model must be 1536-dim for Qdrant vector size)
EMBEDDING_PROVIDER=openai
# EMBED_MODEL=text-embedding-3-small
